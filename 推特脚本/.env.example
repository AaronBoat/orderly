# Twitter/X API 凭证 (OAuth 2.0)
# 从 https://developer.x.com 获取

# OAuth 2.0 凭证（推荐使用）
X_CLIENT_ID=your_client_id_here
X_CLIENT_SECRET=your_client_secret_here
X_BEARER_TOKEN=your_bearer_token_here

# Redirect URI（用于 OAuth 2.0 授权流程）
X_REDIRECT_URI=http://localhost:8080/callback

# 旧版 OAuth 1.0a 凭证（仅用于兼容旧脚本）
# X_API_KEY=your_api_key_here
# X_API_SECRET=your_api_secret_here
# X_ACCESS_TOKEN=your_access_token_here
# X_ACCESS_SECRET=your_access_secret_here

# Telegram Bot 配置（可选）
# 从 @BotFather 获取 token
TELEGRAM_TOKEN=your_telegram_bot_token_here
# 群组 ID，可以是负数，如 -1001234567890
TELEGRAM_GROUP_ID=your_telegram_group_id_here